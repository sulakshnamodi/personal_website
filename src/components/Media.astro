---
// Renders an image from /public, or a neutral placeholder if the file doesn't exist yet.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  src: string;
  alt: string;
  label?: string;
  loading?: 'lazy' | 'eager';
  width?: number;
  height?: number;
}

const { src, alt, label = alt, loading = 'lazy', width, height } = Astro.props;
const exists = fs.existsSync(path.join(process.cwd(), 'public', src));
---

{
  exists ? (
    <img class="media" src={src} alt={alt} loading={loading} decoding="async" width={width} height={height} />
  ) : (
    <div class="media-placeholder" role="img" aria-label={alt}>
      <span aria-hidden="true">{label}</span>
    </div>
  )
}
